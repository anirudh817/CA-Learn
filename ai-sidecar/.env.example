# Copy to ai-sidecar/.env for local development. Never commit the real file.
AI_INSIGHTS_V2=1
AI_DEEP_RESEARCH_ENABLED=1
AI_DEVELOPER_MODE=1
# Read-only prompt, grounding, Pi-event, tool, and Python execution telemetry.
# Both this flag and AI_DEVELOPER_MODE must be enabled; set either to 0 to
# remove the route/API and stop recording new operational turns.
AI_OPERATIONS_CENTER=1
AI_OPERATIONS_RETENTION_TURNS=100
PI_RUNTIME_HOST=127.0.0.1
PI_RUNTIME_PORT=4317
PI_RUNTIME_DEFAULT_POLICY=standard
PI_RUNTIME_RUN_ADAPTER=filesystem
SIGNALFOLD_DATA_DIR=../data

# Provider keys are blank in committed templates.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# A searchable picker is shown by default. Blank allowed-models means any
# tool-capable model returned by the provider catalog.
AI_DEV_MODEL_PICKER=1
AI_DEV_OPENROUTER_MODEL=openrouter/minimax/minimax-m3
AI_DEV_ALLOWED_MODELS=
AI_OPENROUTER_CATALOG_TTL_HOURS=24
AI_LIVE_SMOKE_MAX_USD=0.25

AI_EXTERNAL_SOURCES_DEFAULT=
AI_PYTHON_EXECUTION=developer-local
AI_PYTHON_TRACE=1
AI_PYTHON_TIMEOUT_SECONDS=60
AI_PYTHON_MAX_OUTPUT_BYTES=1048576
AI_PI_MAX_TOOL_ROUNDS=8
AI_PI_TURN_TIMEOUT_SECONDS=180

# Required to encrypt BYOK credentials stored through the settings UI.
SESSION_SECRET=
